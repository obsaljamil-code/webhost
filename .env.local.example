# Copy this file to .env.local and keep it out of version control.

NEXT_PUBLIC_SUPABASE_URL=https://pplocqxuudixppecsfxa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_DBHH6ATEA2evTI_L5ejARA_F6k9Wuky

# The domain + path prefix your sites are served under.
# Sites show up at https://<this>/<their-chosen-name>
NEXT_PUBLIC_ROOT_DOMAIN=host.lavamc.dpdns.org

# Optional: the verification code Google Search Console gives you
# (Settings > Ownership verification > HTML tag > just the content="..." value).
# Leave unset if you're not verifying yet.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SECRET - server only. Never put NEXT_PUBLIC_ in front of this one, or it
# would ship to every visitor's browser. Powers the /admin panel (listing
# users, banning them, approving custom domains).
# Get it from: Supabase dashboard -> your project -> Project Settings -> API
# -> "service_role" key (click reveal, then copy).
SUPABASE_SERVICE_ROLE_KEY=
